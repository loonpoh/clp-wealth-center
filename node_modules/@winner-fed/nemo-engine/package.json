{
  "name": "@winner-fed/nemo-engine",
  "version": "0.1.2",
  "description": "Service Interface API Code generator via Swagger schema",
  "bin": {
    "nemo": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "exports": {
    "require": "./dist/index.js",
    "import": "./dist/index.mjs"
  },
  "typings": "./dist/index.d.ts",
  "scripts": {
    "dev": "tsup --watch",
    "build:core": "tsc --project nemoCore/tsconfig.json",
    "build": "npm run build:core && tsup"
  },
  "dependencies": {
    "axios": "^0.21.1",
    "chalk": "^4.1.2",
    "commander": "^8.3.0",
    "fs-extra": "^5.0.0",
    "inquirer": "^8.2.0",
    "js-yaml": "^4.0.0",
    "lodash": "^4.17.21",
    "node-emoji": "^1.10.0",
    "node-fetch": "^1.7.3",
    "prettier": "^2.4.1",
    "translation.js": "^0.7.15",
    "tsup": "^6.2.3",
    "typescript": "^4.6.2"
  },
  "files": [
    "nemoCore",
    "dist",
    "templates"
  ],
  "keywords": [
    "nemo",
    "swagger",
    "typescript",
    "API"
  ],
  "author": "whaleFE",
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "engines": {
    "node": "^12.20.0 || ^14.13.1 || >=16.0.0"
  }
}
